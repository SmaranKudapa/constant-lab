# Copy to .env for local runs. Never commit .env.
# On Modal, the same keys live in the secret "town-trial-keys":
#   modal secret create town-trial-keys EXA_API_KEY=... PAST_DEV_API_KEY=... OPENAI_API_KEY=...
EXA_API_KEY=
PAST_DEV_API_KEY=
PAST_DEV_PROJECT=town-trial
OPENAI_API_KEY=
# Comma-separated origins allowed to call the API (the Vercel URL plus localhost)
ALLOWED_ORIGINS=http://localhost:8000
